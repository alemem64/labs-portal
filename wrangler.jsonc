// Contract 01(2026-07-14 개정): /api/* 한정 Worker 허용.
// run_worker_first 없음 → 정적 자산 경로는 Worker를 거치지 않고 무료 서빙 유지.
{
  "name": "labs-portal",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leapsignal-analytics",
      "database_id": "REPLACE_AFTER_D1_CREATE"
    }
  ],
  "routes": [
    { "pattern": "leapsignal.net", "custom_domain": true }
  ]
}
